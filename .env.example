# Copy to .env.local for local work. Never commit real values.
# On the host (Vercel) set the same names in the project settings.

# Public site address, no trailing slash. Local: http://localhost:3000
# Production: the real domain. Also used for canonical metadata, the sitemap,
# robots, the Flutterwave return URL and the private order link in emails.
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings > API). Newer dashboards call the first key
# "publishable" and the second "secret". Same purpose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses all row level security. Never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Flutterwave (Settings > API). Use TEST keys until launch day.
# SERVER ONLY.
FLW_SECRET_KEY=
# The "secret hash" you set in Flutterwave Settings > Webhooks. Used to
# check that webhook calls really come from Flutterwave.
FLW_SECRET_HASH=

# Brevo transactional email (Brevo > SMTP & API > API keys).
# SERVER ONLY. The sender email or domain must be verified in Brevo.
# Supabase Auth confirmation/reset emails use Brevo SMTP too, configured in
# Supabase Dashboard > Authentication > SMTP, not through these variables.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Creamice
# Where new-order alerts go. Falls back to store settings support_email.
SELLER_EMAIL=

# Optional. Signs the private links to guest order pages. Set a long random
# value in production. If empty, the Supabase service role key is used, so
# rotating that key invalidates old order links.
# Generate with: openssl rand -hex 32
ORDER_LINK_SECRET=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXX)
NEXT_PUBLIC_GA_ID=

# Optional: Instagram profile URL shown in the storefront footer.
# The link is hidden while this is empty.
NEXT_PUBLIC_INSTAGRAM_URL=

# Set to "off" on the live site to stop the sample catalogue appearing when
# the database has no active products. Leave unset for local preview.
NEXT_PUBLIC_PREVIEW_CATALOG=
